        <mxCell id="Rhe0-Jxv2hhzxxwk4ome-63" value="&lt;div&gt;[GIS Planner]&lt;/div&gt;Define GIS Operations needed to answer this question. Break down the complete question into smallest chunks that can be done with 1 operation.&amp;nbsp;&lt;div&gt;In other words, what steps an expert GIS Anlyst will take to answer this question?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1230" y="2661.5" width="380" height="117" as="geometry" />
        </mxCell>
        <mxCell id="Rhe0-Jxv2hhzxxwk4ome-65" value="&lt;div style=&quot;&quot;&gt;Step 1: Intersect trees that are higher than 3 m and their last trim data &amp;lt; 01.01.2024 with bounding box extent of wijk amsterdamse bos --&amp;gt; return intermediate layer &quot;trees_in_amsterdamse_bos&quot;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Step 2: Intersect water canals with geom bounding box of&amp;nbsp; Amsterdamse bos --&amp;gt;&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;return intermediate layer &quot;canals_in_amsterdamse_bos&quot;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Step 3: I&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;ntersect playgrounds with geom bounding box of&amp;nbsp; Amsterdamse bos --&amp;gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;return intermediate layer &quot;playgrounds_in_amsterdamse_bos&quot;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Step 4: Buffer&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&quot;canals_in_amsterdamse_bos&quot; with radius of 5m --&amp;gt; return intermediate layer &quot;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;canals_in_amsterdamse_bos_buffer_5m&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&quot;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Step 5:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Buffer&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&quot;playgrounds_in_amsterdamse_bos&quot; with radius of {interpretation of close by. ie. 10m} --&amp;gt; return intermediate layer &quot;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;playgrounds_in_amsterdamse_bos_buffer_10m&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Step 6: Intersect&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&quot;trees_in_amsterdamse_bos&quot; with&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;canals_in_amsterdamse_bos_buffer_5m&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&quot; --&amp;gt; return intermediate layer &quot;trees_within_5m_of_canals&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Step 7: overlay&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&quot;trees_within_5m_of_canals&quot; with&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;playgrounds_in_amsterdamse_bos_buffer_10m&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&quot; find trees that do not intersect with playgrounds --&amp;gt; return final layer&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#FFF1E0;strokeColor=#d79b00;glass=0;shadow=0;textShadow=0;align=left;" parent="1" vertex="1">
