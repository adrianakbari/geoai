        <mxCell id="Rhe0-Jxv2hhzxxwk4ome-79" value="&lt;div style=&quot;&quot;&gt;Your job is to find Trees inside wijk Amsterdamse Bos that are taller than 3m and have not been trimmed since&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;01.01.2024&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#FFF1E0;strokeColor=#d79b00;glass=0;shadow=0;textShadow=0;align=left;" parent="1" vertex="1">
