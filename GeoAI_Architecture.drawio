        <mxCell id="Rhe0-Jxv2hhzxxwk4ome-30" value="&lt;div style=&quot;&quot;&gt;- trees inside&amp;nbsp;&lt;span style=&quot;text-align: center; background-color: initial;&quot;&gt;Wijk Amsterdamse Bos&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- water canals inside&amp;nbsp;&lt;span style=&quot;text-align: center; background-color: initial;&quot;&gt;Wijk Amsterdamse Bos&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Playgrounds inside&amp;nbsp;&lt;span style=&quot;text-align: center; background-color: initial;&quot;&gt;Wijk Amsterdamse Bos&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;text-align: center; background-color: initial;&quot;&gt;- Trees within 5m from water canals&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;text-align: center; background-color: initial;&quot;&gt;- Trees not close by playgrounds&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;text-align: center; background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#FFF1E0;strokeColor=#d79b00;glass=0;shadow=0;textShadow=0;align=left;" parent="1" vertex="1">
